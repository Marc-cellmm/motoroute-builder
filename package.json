{
  "name": "motoroute-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:ios": "tsc -b && vite build --mode ios && cap sync ios",
    "ios": "npm run build:ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
